    {
      "id": "c8a12XVSdwwSmQ5zGQgMI",
      "type": "text",
      "x": 3804.309708674748,
      "y": 5735.771402001385,
      "width": 1278.2525634765625,
      "height": 720,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
